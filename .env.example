# Verdict environment reference. Nothing loads this file: export the variables in the shell that starts a service
# (`pnpm dev:stack` sets VERDICT_DEMO_TOGGLES=1 and, with --wallet, VERDICT_WALLET=1 by itself).
# Seeds and keys never live here: they are files under VERDICT_DATA_DIR, created by `pnpm keys:init`.

# --- mode and data ---
VERDICT_MODE=dev                    # dev | test | demo (FakeWallet and FakeLlm refuse to run in demo)
VERDICT_NETWORK=regtest             # regtest only for the demo
VERDICT_DATA_DIR=~/.verdict-data    # identities.json, keys/, network.json, peers.json, ledgers
VERDICT_PEERS_FILE=                 # default <VERDICT_DATA_DIR>/peers.json ({ "engine": url, "worker": url, "verifier": url })

# --- ports (defaults) ---
ENGINE_PORT=7401                    # capability engine (LAN route only with VERDICT_LAN_BIND)
BUYER_PORT=7402                     # buyer agent, loopback only
PRINCIPAL_SIGNER_PORT=7403          # principal signer, loopback only, UI requests carry x-verdict-ui: 1
VERIFIER_PORT=7404                  # verifier (Mac or Legion)
WORKER_PORT=7405                    # worker node
WALLET_BUYER_URL=http://127.0.0.1:7411
WALLET_WORKER_URL=http://127.0.0.1:7412

# --- peers (override peers.json; only the verifier differs on the Legion when the verifier runs on the Mac) ---
ENGINE_URL=                         # e.g. http://LEGION_IP:7401 (used by the Mac verifier)
WORKER_URL=                         # e.g. http://LEGION_IP:7405
VERIFIER_URL=                       # e.g. http://MAC_IP:7404

# --- LAN and browser ---
VERDICT_LAN_BIND=                   # the machine's own IPv4 on the cable/hotspot; opens POST /v0/messages to the LAN. Host header must equal <ip>:<port>
VERDICT_UI_ORIGIN=                  # comma list; default http://localhost:5173,http://127.0.0.1:5173

# --- demo switches ---
VERDICT_DEMO_TOGGLES=               # 1 enables the demo console routes (mine until refund, compromised agent)
VERDICT_WALLET=                     # 1 makes the engine handle TASK_ACCEPT / HODL_INVOICE through the wallet daemons
VERDICT_WORKER_SILENCE_MS=20000     # engine emits WORKER_STATUS stopped after this silence
WORKER_SABOTAGED=                   # 1: worker delivers a broken file on purpose (labelled)
WORKER_DISAPPEARS=                  # 1: worker accepts, locks, then never delivers

# --- engine policy ---
ENGINE_LEDGER_PATH=                 # default <VERDICT_DATA_DIR>/engine-ledger.sqlite
MAX_LOCK_SECONDS=28800              # contract max lock window
SAFETY_MARGIN_SECONDS=600           # added to deadline + verify time in the HTLC timing check
MAX_ROOT_AMOUNT=500.00              # hard limit for a root mandate (signer and engine)
MAX_ROOT_EXPIRY_SECONDS=86400       # hard limit for a root mandate

# --- regtest (set by `pnpm regtest:setup` into network.json; env overrides) ---
BITCOIND_RPC_URL=http://127.0.0.1:18443
BITCOIND_RPC_USER=user
BITCOIND_RPC_PASSWORD=password
INDEXER_URL=tcp://127.0.0.1:50001
RGB_PROXY_URL=rpc://127.0.0.1:3000/json-rpc

# --- local models (QVAC, Legion only; models must be in the cache before the demo) ---
BUYER_MODEL=                        # default QWEN3_8B_INST_Q4_K_M
WORKER_MODEL=                       # default Qwen3.5 9B (see docs/SDK_NOTES.md)
WORKER_MAX_TOKENS=

# --- verifier ---
# engine and worker must point at the same package directory until per-task routing (E31) lands
VERIFIER_PACKAGE_DIR=               # default verifier-packages/csv2json-v1
VERIFIER_REGISTRY=                  # default <VERDICT_DATA_DIR>/verifier/registry.json

# --- demo UI (Vite, build time) ---
VITE_ENGINE_HOST=                   # default location.hostname
VITE_ENGINE_PORT=7401
VITE_SIGNER_PORT=7403
VITE_BUYER_PORT=7402
VITE_VERIFIER_HOST=
VITE_VERIFIER_PORT=7404
