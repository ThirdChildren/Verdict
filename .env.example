# Copy to .env (git-ignored). Seeds and keys live in VERDICT_DATA_DIR, never in the repo.
VERDICT_MODE=dev                  # dev | test | demo (fakes throw in demo)
VERDICT_NETWORK=regtest           # regtest | signet (optional Mutinynet run)
VERDICT_DATA_DIR=~/.verdict-data

ENGINE_PORT=7401
BUYER_PORT=7402                   # localhost only
WORKER_PORT=7403
VERIFIER_PORT=7404
VERIFIER_URL=http://localhost:7404
VERIFIER_PUBLIC_ID=               # Ed25519 public key hex, printed by the verifier on first start
WORKER_PUBLIC_ID=                 # worker EVM address, printed by the worker on first start

TUSD_ASSET_ID=                    # set by the regtest issue-tUSD script
TUSD_PRECISION=
SAFETY_MARGIN_SECONDS=120

BITCOIND_RPC_URL=http://127.0.0.1:18443
BITCOIND_RPC_USER=user
BITCOIND_RPC_PASSWORD=password
INDEXER_URL=tcp://127.0.0.1:50001
RGB_PROXY_URL=rpc://127.0.0.1:3000/json-rpc

QVAC_BUYER_MODEL=
QVAC_WORKER_MODEL=
